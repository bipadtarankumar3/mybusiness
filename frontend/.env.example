# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only: where Next.js proxies /api/v1/* requests (5050 avoids macOS ControlCenter on 5000)
BACKEND_URL=http://127.0.0.1:5050

# Google Identity Services Client ID (optional in local dev)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
