NODE_ENV=development
PORT=5050
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Database (MySQL 8 in dev & prod; sqlite ONLY for test suite)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chatflow
DB_USER=chatflow_user
DB_PASSWORD=chatflow_pass_dev

# Secrets (Required in production; >= 32 chars for AUTH_SECRET)
AUTH_SECRET=replace-with-at-least-32-chars-random-secret-key
PASSWORD_RESET_SECRET=replace-with-password-reset-hmac-secret-key
CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-encryption-secret-key

# Google OAuth 2.0 / Google Identity Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/api/v1/auth/google/callback

# Facebook Login / Meta App
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5050/api/v1/auth/facebook/callback

# Razorpay Payment Gateway (Optional server-wide fallback; users can also configure in Settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (Optional — runs in honest Demo / Simulated mode when blank)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WA_MARKETING_RATE_INR=0.88
WA_UTILITY_RATE_INR=0.13

# Redis (Optional — falls back to in-process async dispatcher when blank)
REDIS_URL=redis://127.0.0.1:6379

# Email SMTP (Optional — dev password reset returns devResetUrl when blank in development)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# AI Provider (Optional — returns 409 NOT_CONFIGURED when blank)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Explicit Demo Flag
DEMO_MODE=true
